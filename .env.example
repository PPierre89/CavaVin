# Génère une vraie valeur secrète en prod, ex: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
# True en local (venv, `runserver`) ; False recommandé dès que l'app est exposée
# sur le réseau (docker-compose met déjà False par défaut si cette variable est absente).
DJANGO_DEBUG=True
# Ajoute l'IP ou le nom d'hôte de ton NAS pour y accéder depuis d'autres appareils,
# ex: DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.50,mon-nas.local
# Le joker de sous-domaine ".exemple.com" est accepté (ex: .ugdocker.link pour l'accès distant UGREEN).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Accès via un domaine proxifié en HTTPS (accès distant UGREEN, reverse proxy) : nécessaire pour
# que les POST (login admin, frontend) passent la vérification CSRF. Le joker est accepté.
# ex: DJANGO_CSRF_TRUSTED_ORIGINS=https://*.ugdocker.link
# DJANGO_CSRF_TRUSTED_ORIGINS=
# Si le proxy termine le TLS et transmet X-Forwarded-Proto, mets True pour que Django voie du HTTPS.
# Active aussi les cookies sécurisés (session admin, CSRF) : ils ne transitent plus qu'en HTTPS.
# DJANGO_TRUST_PROXY_SSL=False
# HSTS (secondes) : impose HTTPS au navigateur. Défaut 0 = désactivé. À activer (ex. 31536000 = 1 an)
# seulement une fois le HTTPS stable et permanent, sinon un accès LAN en HTTP peut être verrouillé.
# DJANGO_HSTS_SECONDS=0
# Port hôte exposé par docker-compose (défaut 8000). Change-le si 8000 est déjà pris, ex: APP_PORT=4173.
# APP_PORT=8000
# Compte admin créé automatiquement au 1er démarrage du conteneur (laisser vide = ne rien créer).
# Idempotent : ne recrée/n'écrase rien si le compte existe déjà.
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_PASSWORD=change-me-en-un-vrai-mot-de-passe
# DJANGO_SUPERUSER_EMAIL=admin@example.com

# Reconnaissance d'étiquette & recherche de vin via Claude (Anthropic) — provider
# principal de la cascade (vision + connaissances œnologiques). Laisser vide le désactive.
# Clé à créer sur https://platform.claude.com/
ANTHROPIC_API_KEY=
# Modèle utilisé (défaut : claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
# Timeout de l'appel Claude (secondes). Doit rester STRICTEMENT INFÉRIEUR au
# timeout worker gunicorn (le repo lance --timeout 120). Défaut 50.
# ANTHROPIC_TIMEOUT=50

# Enrichissement externe (US 04) — repli de la cascade derrière Claude ; apporte
# aussi les données marchandes (prix, notes). Laisser vide désactive le provider wineapi.
WINEAPI_KEY=
# WINEAPI_BASE_URL=https://api.wineapi.io
# Timeouts des appels wineapi (secondes). Défauts volontairement < 30 s pour
# rester sous le timeout worker gunicorn même sur une conf obsolète (sinon un
# appel lent fait tuer le worker). À relever seulement si le worker gunicorn a
# un timeout confortable (le repo lance --timeout 120).
# WINEAPI_TIMEOUT=20
# Identification par photo (vision) : plus lente, timeout dédié en secondes.
# WINEAPI_IMAGE_TIMEOUT=25
# WINEAPI_ENRICH_DETAIL=True
# Garde-fou du bouton de synchro : délai min (secondes) entre deux re-fetch d'un
# même vin, pour préserver le quota d'appels wineapi. Défaut 3600 (1 h).
# WINEAPI_REFRESH_COOLDOWN=3600

# Enrichissement GrapeMinds (api.grapeminds.eu) — repli œnologique supplémentaire
# en aval de wineapi (recherche texte + détail ; analyse photo réservée à l'offre
# Enterprise). Clé à créer sur https://grapeminds.fr/ (settings > API keys).
GRAPEMINDS_KEY=
# DÉSACTIVÉ PAR DÉFAUT même clé renseignée : mettre True pour l'activer. À n'activer
# qu'après avoir validé (1) la licence de stockage persistant (PSL) — les conditions
# GrapeMinds imposent une licence payante pour conserver durablement leurs données
# dans le catalogue local — et (2) le quota (offre publique ~250 appels/mois).
# GRAPEMINDS_ENABLED=False
# Langue des libellés (de, en, es, fr, it, da).
# GRAPEMINDS_LANG=fr
# GRAPEMINDS_BASE_URL=https://api.grapeminds.eu/public/v1
# Timeouts (secondes), volontairement < 30 s (cf. worker gunicorn). Vision plus lente.
# GRAPEMINDS_TIMEOUT=20
# GRAPEMINDS_IMAGE_TIMEOUT=25
# Récupère le détail (/wines/{id}) après la recherche pour cépages/région/descriptions.
# GRAPEMINDS_ENRICH_DETAIL=True
# Analyse d'étiquette par photo (/photo/analyze) — nécessite l'offre Enterprise.
# GRAPEMINDS_PHOTO_ANALYSIS=False
# Nombre de candidats demandés à la recherche (on retient le meilleur).
# GRAPEMINDS_SEARCH_LIMIT=5

# Enrichissement Vinou (api.vinou.de) — catalogue des vins des domaines inscrits
# sur Vinou (surtout allemands) : recherche texte et code-barres (gtin). Compte à
# créer sur https://app.vinou.de/. Routes en POST JSON.
# DÉSACTIVÉ PAR DÉFAUT : mettre True pour l'activer — la couverture est de niche
# (domaines clients Vinou), utile en complément seulement.
# VINOU_ENABLED=False
# Authentification JWT (cf. https://doc.vinou.de/api/authentification) : génère un
# API-Token dans l'app Vinou (module Tokens) et récupère ton AuthID (Réglages).
# Le provider fait POST /service/login → JWT (12 h), mis en cache et renouvelé seul.
# Optionnels : sans eux, mode public (routes /wines/* publiques, données plus pauvres).
# VINOU_AUTH_ID=
# VINOU_API_TOKEN=
# JWT déjà obtenu, fourni tel quel (override du login) — usage avancé.
# VINOU_TOKEN=
# VINOU_BASE_URL=https://api.vinou.de
# VINOU_TIMEOUT=20
# VINOU_SEARCH_LIMIT=5

# Repli 100 % local et gratuit (dernier maillon de la cascade) : OCR Tesseract +
# référentiel LWIN importé via `manage.py import_lwin` (dump gratuit Liv-ex).
# Activé par défaut ; sans dump importé ni binaire tesseract, il est simplement inerte.
# LWIN_ENABLED=True
# TESSERACT_CMD=tesseract
# Budget total de l'OCR en secondes (toutes passes tesseract confondues).
# TESSERACT_TIMEOUT=20
